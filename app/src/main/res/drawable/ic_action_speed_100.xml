<?xml version="1.0" encoding="utf-8"?>
<!--
  再生速度 1.00x(等速)。速度計の文字盤は Material Symbols の "speed"(Apache-2.0)。

  文字盤は中心(12,14)・内半径8・外半径10のリング。針は同じ中心を軸に回すので、
  4段階の速度で ic_action_speed_100/125/150/200 の rotation だけが異なる
  (-90 / -60 / -30 / 0 = 10時半 → 11時半 → 12時半 → 1時半)。針は 0.75 倍に縮めてあり、
  先端の半径は 7.5 でリングの内側に収まる。
  等速だけ白、それ以外は水色にして「今は既定ではない」と一目で分かるようにする
  (CC/SI/音声の白=OFF・水色=ON と同じ約束)。
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24">
    <!-- 文字盤 -->
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M20.38,8.57l-1.23,1.85a8,8 0,0 1,-0.22 7.58H5.07A8,8 0,0 1,15.58 6.85l1.85,-1.23A10,10 0,0 0,3.35 19a2,2 0,0 0,1.72 1h13.85a2,2 0,0 0,1.74 -1a10,10 0,0 0,-0.27 -10.44z"/>
    <!-- 針 -->
    <group
        android:pivotX="12"
        android:pivotY="14"
        android:rotation="-90"
        android:scaleX="0.75"
        android:scaleY="0.75">
        <path
            android:fillColor="#FFFFFF"
            android:pathData="M10.59,15.41a2,2 0,0 0,2.83 0l5.66,-8.49 -8.49,5.66a2,2 0,0 0,0 2.83z"/>
    </group>
</vector>
