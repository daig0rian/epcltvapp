<?xml version="1.0" encoding="utf-8"?>
<!--
  アプリ内アップデートのダイアログ。同意・確認中・結果・ダウンロード・エラーの
  すべての段をこの1枚で表し、AppUpdateDialogFragment が表示とボタンを差し替える。

  ScrollView は wrap_content + weight。ウィンドウ高さを WRAP_CONTENT にしてあるので、
  本文が短い同意画面では小さく、リリースノートが長いときだけ画面いっぱいまで伸びる。
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="32dp"
    android:background="@color/default_background">

    <TextView
        android:id="@+id/app_update_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="@android:color/white"
        android:textSize="20sp"
        android:textStyle="bold"
        android:paddingBottom="12dp"
        android:focusable="false" />

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#40FFFFFF"
        android:layout_marginBottom="12dp" />

    <ScrollView
        android:id="@+id/app_update_scroll"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:focusable="true"
        android:focusableInTouchMode="false"
        android:scrollbars="vertical"
        android:nextFocusDown="@id/app_update_negative">

        <TextView
            android:id="@+id/app_update_body"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@android:color/white"
            android:textSize="16sp"
            android:lineSpacingMultiplier="1.4"
            android:focusable="false" />

    </ScrollView>

    <ProgressBar
        android:id="@+id/app_update_progress"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:max="100"
        android:indeterminate="false"
        android:visibility="gone" />

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="end"
        android:layout_marginTop="12dp"
        android:orientation="horizontal">

        <Button
            android:id="@+id/app_update_negative"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="8dp"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingTop="8dp"
            android:paddingBottom="8dp"
            android:textSize="14sp"
            android:textAllCaps="false"
            android:textColor="@color/dialog_button_text"
            android:background="@drawable/bg_dialog_button"
            android:focusable="true"
            android:nextFocusUp="@id/app_update_scroll"
            android:nextFocusRight="@id/app_update_positive" />

        <Button
            android:id="@+id/app_update_positive"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingTop="8dp"
            android:paddingBottom="8dp"
            android:textSize="14sp"
            android:textAllCaps="false"
            android:textColor="@color/dialog_button_text"
            android:background="@drawable/bg_dialog_button"
            android:focusable="true"
            android:nextFocusUp="@id/app_update_scroll"
            android:nextFocusLeft="@id/app_update_negative" />

    </LinearLayout>

</LinearLayout>
